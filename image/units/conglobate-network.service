[Unit]
Description=Keep the appliance network available for build commands
Before=conglobate-build.service
FailureAction=poweroff-force

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mkdir -p /run/pichi
ExecStart=/usr/bin/touch /run/pichi/netns
ExecStart=/usr/bin/mount --bind /proc/1/ns/net /run/pichi/netns
ExecStop=/usr/bin/umount /run/pichi/netns
