#!/usr/bin/python3
"""Trusted inspection replaces entry only to stop before any image execution."""
from pathlib import Path
import sys
assert sys.argv[1:] == ['/work/view', '/command', '--restricted']
mode = Path('/work/mode').read_text()
mounts = {}
for line in Path('/proc/self/mountinfo').read_text().splitlines():
    left, right = line.split(' - ', 1)
    mounts[left.split()[4]] = right.split()[0]
for name, kind in (('proc', 'proc'), ('dev', 'tmpfs')):
    linked = mode == 'both-links' or mode == name + '-link'
    target = '/work/canary-' + name if linked else '/work/view/' + name
    assert mounts.get(target) == kind, (mode, target, mounts)
    if linked:
        assert '/work/view/' + name not in mounts
        print('IMAGE_SYMLINK_REDIRECTED_RUNTIME_MOUNT', mode, name, flush=True)
print('RUNTIME_PATH_PRE_ENTRY_CHECK', mode, flush=True)
