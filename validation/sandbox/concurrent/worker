#!/bin/bash
set -eu
name=$1
p=/work/$name
fuse2fs -f -o acl,allow_other "$p/image" "$p/view" >"$p/log" 2>&1 &
daemon=$!
for ((i=0;i<100;i++)); do mountpoint -q "$p/view" && break; sleep .05; done
mountpoint -q "$p/view"
echo "$name" >"$p/view/identity"
if test "$name" = A; then
 kill -STOP "$daemon"
 touch "$p/view/blocked" &
 client=$!
 touch "$p/ready"
 if wait "$client"; then exit 1; fi
 kill -KILL "$daemon"
 wait "$daemon" || true
else
 touch "$p/ready"
 for ((i=0;i<200;i++)); do test -f "$p/continue" && break; sleep .05; done
 test -f "$p/continue"
 test "$(cat "$p/view/identity")" = B
 echo after-other-abort >"$p/view/after"
 echo CONCURRENT_BUILD_SURVIVES_PASS
fi
fusermount3 -u "$p/view"
if test "$name" = B; then wait "$daemon"; fi
