#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in fuse loop dm_mod dm_snapshot dm_verity dm_zero; do modprobe "$module"; done
dmsetup version
mount -t fusectl none /sys/fs/fuse/connections
chmod 666 /dev/fuse
mkdir /work/view
truncate -s 64M /work/base
mkfs.ext4 -qF /work/base
mount -o loop /work/base /work/view
printf 'base fixture\n' >/work/view/inherited
printf 'base value\n' >/work/view/changed
mkdir -p /work/view/bin /work/view/lib64 /work/view/.old /work/view/proc /work/view/dev /work/view/tmp
for tool in bash cat chmod chown stat sleep; do cp "/usr/bin/$tool" /work/view/bin/; done
cp -a /usr/lib64/. /work/view/lib64/
cp /command /work/view/command
chmod 755 /work/view/command
umount /work/view
chown 100000:100000 /work/view
sha256sum /work/base >/work/base.sha256
mkdir -p /sys/fs/cgroup
mount -t cgroup2 none /sys/fs/cgroup
echo RESTART_FAILED_ATTEMPT_BEGIN
python3 /guardian.py
echo RESTART_FAILED_ATTEMPT_END
sha256sum -c /work/base.sha256
test ! -e /work/published
test ! -e /work/verified
for ((i=0;i<100;i++)); do
 if test "$(dmsetup ls)" = 'No devices found' && test -z "$(losetup -a)"; then break; fi
 sleep .05
done
test "$(dmsetup ls)" = 'No devices found'
test -z "$(losetup -a)"
for connection in /sys/fs/fuse/connections/*; do test ! -e "$connection"; done
echo SUPERVISOR_DEATH_FUSE_CONNECTIONS_RELEASED
echo SUPERVISOR_DEATH_NO_SEAL_DEVICE_CLEANUP_PASS
# Restart from identical immutable inputs, with a new output/work directory.
# Only trusted orchestration changes: the second attempt runs to completion.
mkdir /retry /retry/view
chmod 1777 /retry
chown 100000:100000 /retry/view
cp --sparse=always /work/base /retry/base
cp /retry-worker /chain-worker
cp /retry-launch /command-launch
echo RESTART_FRESH_ATTEMPT_BEGIN
unshare --mount /bin/bash /restart-run /retry
echo RESTART_FRESH_ATTEMPT_END
test -f /retry/published/inventory.cbor
test ! -e /work/published
sha256sum -c /work/base.sha256
cmp /work/base /retry/base
for ((i=0;i<100;i++)); do
 if test "$(dmsetup ls)" = 'No devices found' && test -z "$(losetup -a)"; then break; fi
 sleep .05
done
test "$(dmsetup ls)" = 'No devices found'
test -z "$(losetup -a)"
for connection in /sys/fs/fuse/connections/*; do test ! -e "$connection"; done
echo SUPERVISOR_DEATH_FULL_RESTART_PASS
