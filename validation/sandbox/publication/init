#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
modprobe fuse
modprobe loop
modprobe dm_mod
chmod 666 /dev/fuse
mkdir /work/view
chown 100000:100000 /work /work/view
for variant in patched-clean baseline-close patched-close patched-error patched-recovered patched-clean-exhaust patched-publish-exhaust; do
 case "$variant" in
  baseline-clean) binary=/baseline; mode=clean; expected=0 ;;
  patched-clean|patched-clean-exhaust|patched-publish-exhaust) binary=/patched; mode=clean; expected=0 ;;
  baseline-close) binary=/baseline-close; mode=clean; expected=0 ;;
  patched-close) binary=/patched-close; mode=clean; expected=32 ;;
  baseline-error) binary=/baseline; mode=error; expected=0 ;;
  patched-error) binary=/patched; mode=error; expected=32 ;;
  patched-recovered) binary=/patched; mode=recovered; expected=32 ;;
 esac
 echo "PUBLICATION_CASE $variant"
 rm -rf /work/sealed /work/artifact /work/output
 rm -f /work/status
 touch /work/status
 chown 100000:100000 /work/status
 rm -f /work/ready /work/finish /work/do-error /work/error-observed /work/fuse.log
 truncate -s 0 /work/image
 truncate -s 64M /work/image
 mkfs.ext4 -qF /work/image
 loop=$(losetup --find --show /work/image)
 dmsetup create finalize --noudevsync --table "0 131072 linear $loop 0"
 dmsetup mknodes --noudevsync
 chown 100000:100000 /dev/mapper/finalize
 unshare --user --mount --net --map-users 0:100000:65536 \
  --map-groups 0:100000:65536 --setuid 0 --setgid 0 \
  /bin/bash /worker "$binary" "$variant" "$expected" &
 worker=$!
 for ((i=0;i<100;i++)); do test -f /work/ready && break; sleep .05; done
 test -f /work/ready
 if test "$mode" != clean; then
  dmsetup suspend --noflush --nolockfs finalize
  dmsetup load finalize --table '0 131072 error'
  dmsetup resume --noflush --nolockfs finalize
 fi
 if test "$mode" = recovered; then
  touch /work/do-error
  for ((i=0;i<100;i++)); do test -f /work/error-observed && break; sleep .05; done
  test -f /work/error-observed
  dmsetup suspend --noflush --nolockfs finalize
  dmsetup load finalize --table "0 131072 linear $loop 0"
  dmsetup resume --noflush --nolockfs finalize
 fi
 touch /work/finish
 wait "$worker"
 dmsetup remove --noudevsync finalize
 losetup -d "$loop"
 # Worker has unmounted/reaped; remove all writable device mappings before
 # converting immutable bytes. No recipe command runs in this fixture.
 chown 0:0 /work/image
 chmod 400 /work/image
 if test "$(cat /work/status)" = 0; then
  e2fsck -fn /work/image
  if test "$variant" = patched-clean-exhaust; then
   mkdir -p /work/tiny
   mount -t tmpfs -o size=4k tmpfs /work/tiny
   set +e
   /publication-helper /work/image /work/sealed /work/tiny/artifact /work/output
   result=$?
   set -e
   test "$result" = 28
   test ! -e /work/output
   test ! -e /work/tiny/artifact/inventory.cbor
   umount /work/tiny
   echo PUBLICATION_REJECTED_ENOSPC
  elif test "$variant" = patched-publish-exhaust; then
   mkdir -p /work/tiny
   mount -t tmpfs -o size=4k tmpfs /work/tiny
   set +e
   /publication-helper /work/image /work/sealed /work/artifact /work/tiny/output
   result=$?
   set -e
   test "$result" = 28
   test -f /work/artifact/inventory.cbor
   test ! -e /work/tiny/output
   shopt -s nullglob dotglob
   leftovers=(/work/tiny/*)
   test "${#leftovers[@]}" = 0
   shopt -u nullglob dotglob
   umount /work/tiny
   echo PUBLICATION_COPY_ENOSPC_CLEANUP_PASS
  else
   /publication-helper /work/image /work/sealed /work/artifact /work/output
   test -f /work/output/inventory.cbor
   echo "PUBLICATION_ACCEPTED $variant"
  fi
 else
  test ! -e /work/output
  test ! -e /work/artifact
  test ! -e /work/sealed
  echo "PUBLICATION_REJECTED $variant"
 fi
 chmod 600 /work/image
done
echo PUBLICATION_MATRIX_COMPLETE
