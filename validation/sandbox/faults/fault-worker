#!/bin/bash
set -eu
fuse2fs -f -o acl,allow_other${1:+,$1} /dev/mapper/fault /work/view >/work/fuse.log 2>&1 &
daemon=$!
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
echo dirty >/work/view/dirty
touch /work/ready
for ((i=0;i<200;i++)); do test -f /work/finish && break; sleep .05; done
test -f /work/finish
set +e
fusermount3 -u /work/view
unmount_status=$?
wait "$daemon"
status=$?
set -e
echo "FAULT_UNMOUNT_STATUS $unmount_status"
echo "FAULT_DAEMON_STATUS $status"
cat /work/fuse.log
