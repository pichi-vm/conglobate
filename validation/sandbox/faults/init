#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
modprobe fuse
modprobe loop
modprobe dm_mod
chmod 666 /dev/fuse
mkdir /work/view
chown 100000:100000 /work /work/view
for mode in default errors=panic; do
 echo "FAULT_MODE $mode"
 truncate -s 0 /work/image
 truncate -s 64M /work/image
 mkfs.ext4 -qF /work/image
 loop=$(losetup --find --show /work/image)
 dmsetup create fault --noudevsync --table "0 131072 linear $loop 0"
 dmsetup mknodes --noudevsync
 chown 100000:100000 /dev/mapper/fault
 rm -f /work/ready /work/finish /work/fuse.log
 if test "$mode" = default; then option=; else option=$mode; fi
 unshare --user --mount --net --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /fault-worker "$option" &
 worker=$!
 for ((i=0;i<100;i++)); do test -f /work/ready && break; sleep .05; done
 test -f /work/ready
 dmsetup suspend --noflush --nolockfs fault
 dmsetup load fault --table '0 131072 error'
 dmsetup resume --noflush --nolockfs fault
 touch /work/finish
 wait "$worker"
 dmsetup remove --noudevsync fault
 losetup -d "$loop"
done
echo FAULT_PROBE_COMPLETE
