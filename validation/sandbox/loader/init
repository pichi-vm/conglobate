#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
echo supervisor-canary >/supervisor-secret
chmod 644 /supervisor-secret
for mode in inherited sanitized; do
 root=/work/$mode
 mkdir -p "$root/bin" "$root/usr/bin" "$root/lib64" "$root/.old"
 cp /usr/bin/bash "$root/bin/bash"
 cp /usr/bin/cat "$root/bin/cat"
 cp -a /usr/lib64/. "$root/lib64/"
 cp /check "$root/usr/bin/python3"
 mkdir "$root/tmp"
 chmod 1777 "$root/tmp"
 rm -f /work/loader-canary
 chmod 755 "$root/usr/bin/python3"
 EVIL_SETUP=must-not-inherit unshare --user --mount --pid --net --ipc --uts --fork --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /launch "$mode" 9</supervisor-secret
 if test "$mode" = inherited; then
  test "$(cat /work/loader-canary)" = 'loaded-before-isolation'
  echo HELPER_LOADER_ENV_NEGATIVE_CONTROL_CONFIRMED
 else
  test ! -e /work/loader-canary
  echo HELPER_LAUNCH_ENV_SANITIZED_PASS
 fi
done
echo LOADER_MATRIX_PASS
