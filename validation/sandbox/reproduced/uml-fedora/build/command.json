[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "6144",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-network-policy-v4/vmlinuz",
  "-initrd",
  "/var/tmp/conglobate-uml-fedora-v4/initramfs",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=1 quiet",
  "-netdev",
  "user,id=public",
  "-device",
  "virtio-net-pci,netdev=public",
  "-drive",
  "file=/dev/shm/conglobate-fedora-conglobate-uml-fedora-v4.raw,format=raw,if=none,id=output",
  "-device",
  "virtio-blk-pci,drive=output"
]
