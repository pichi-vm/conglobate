#!/bin/bash
set -eu
mount --make-rprivate /
mount --bind /work/view /work/view
mount -t proc -o nosuid,nodev,noexec proc /work/view/proc
mount -t tmpfs -o nosuid,noexec tmpfs /work/view/dev
# No runtime device nodes are needed by this bounded command; stdin is already
# the trusted /dev/null handle and output is a pipe.
# Known fixture target of the image's absolute symlink; do not let the host
# follow /etc/resolv.conf's absolute link outside the image root.
for target in /work/view/run/image-resolv /work/view/etc/regular-resolv; do
 mount --bind /work/resolver "$target"
 mount -o remount,bind,ro "$target"
done
exec /entry-helper /work/view /command --restricted
