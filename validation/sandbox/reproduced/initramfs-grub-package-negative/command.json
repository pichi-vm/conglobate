[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "8192",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-initramfs-guest-v6/vmlinuz",
  "-initrd",
  "/tmp/conglobate-initramfs-guest-v6/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet",
  "-device",
  "virtio-serial-pci",
  "-chardev",
  "file,id=artifact,path=/tmp/conglobate-initramfs-guest-v6/boot-artifacts.bin",
  "-device",
  "virtserialport,chardev=artifact,name=conglobate.validation.export"
]
