[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-fedora-root-boot-v2/kernel",
  "-initrd",
  "/tmp/conglobate-fedora-root-boot-v2/initramfs",
  "-drive",
  "file=/tmp/conglobate-fedora-root-boot-v2/rootfs.raw,format=raw,if=none,id=owned,snapshot=on",
  "-device",
  "virtio-blk-pci,drive=owned",
  "-append",
  "console=ttyS0 root=/dev/vda rw selinux=0 panic=-1 rd.shell=0 systemd.unit=multi-user.target"
]
