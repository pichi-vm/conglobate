#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in fuse loop dm_mod dm_snapshot dm_verity dm_zero; do modprobe "$module"; done
dmsetup version
chmod 666 /dev/fuse
mkdir /work/view
truncate -s 64M /work/base
mkfs.ext4 -qF /work/base
mount -o loop /work/base /work/view
printf 'base fixture\n' >/work/view/inherited
printf 'base value\n' >/work/view/changed
mkdir -p /work/view/bin /work/view/lib64 /work/view/.old /work/view/proc /work/view/dev /work/view/tmp
for tool in bash cat chmod chown stat sleep; do cp "/usr/bin/$tool" /work/view/bin/; done
cp -a /usr/lib64/. /work/view/lib64/
cp /command /work/view/command
chmod 755 /work/view/command
target=$(cat /runtime-link-name)
case "$target" in proc|dev|.old) ;; *) exit 1 ;; esac
mkdir /work/canary
printf 'owned canary unchanged\n' >/work/canary/sentinel
rm -r "/work/view/$target"
ln -s /work/canary "/work/view/$target"
umount /work/view
chown 100000:100000 /work/view
mount -t fusectl none /sys/fs/fuse/connections
sha256sum /work/base >/work/base.sha256
sha256sum /work/canary/sentinel >/work/canary.sha256
sha256sum /proc/self/mountinfo >/work/mounts.sha256
set +e
/publication-helper --publish
status=$?
set -e
test "$status" = 101
test ! -e /work/verified
test ! -e /work/published
sha256sum -c /work/base.sha256
sha256sum -c /work/canary.sha256
sha256sum -c /work/mounts.sha256
for ((i=0;i<100;i++)); do
 if test "$(dmsetup ls)" = 'No devices found' && test -z "$(losetup -a)"; then break; fi
 sleep .05
done
test "$(dmsetup ls)" = 'No devices found'
test -z "$(losetup -a)"
for connection in /sys/fs/fuse/connections/*; do test ! -e "$connection"; done
echo RUNTIME_SETUP_FAILURE_BASE_MOUNTS_FUSE_STORAGE_CLEANUP_PASS
echo FUSE_RUNTIME_LINK_REJECTED_WITH_CANARY_PRESERVED
