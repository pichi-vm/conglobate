#!/bin/bash
set -euo pipefail
mount --make-rprivate /
p=/work/tool
mkdir -p "$p"/{usr,etc,rpms,proc,dev,sys,tmp,var/tmp,run,output,.old}
mount --bind "$p" "$p"
for directory in usr etc rpms rpms43 rpms44; do
 mount --bind "/$directory" "$p/$directory"
 mount -o remount,bind,ro "$p/$directory"
done
for directory in bin sbin lib lib64; do ln -s "usr/$directory" "$p/$directory"; done
cp /bootstrap-command "$p/command"
cp /distro-upgrade-command "$p/distro-upgrade-command"
chmod 755 "$p/command"
mount --bind /work/view "$p/output"
# Tool commands and installroot scriptlets share only this command's runtime
# view. Each root gets private device storage and the command PID namespace.
for runtime in "$p" "$p/output"; do
 mkdir -p "$runtime/proc" "$runtime/dev" "$runtime/sys"
done
/runtime-pair "$p" "$p/output"
for runtime in "$p" "$p/output"; do
 for d in null zero random urandom; do
  touch "$runtime/dev/$d"
  mount --bind "/work/runtime/$d" "$runtime/dev/$d"
 done
 ln -s /proc/self/fd "$runtime/dev/fd"
 ln -s /proc/self/fd/0 "$runtime/dev/stdin"
 ln -s /proc/self/fd/1 "$runtime/dev/stdout"
 ln -s /proc/self/fd/2 "$runtime/dev/stderr"
done
exec /entry-helper "$p" /command --restricted
