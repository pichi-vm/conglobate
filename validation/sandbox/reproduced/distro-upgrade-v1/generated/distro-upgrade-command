#!/bin/bash
set -euo pipefail
common=(--no-plugins --installroot=/output --use-host-config --setopt=install_weak_deps=False --no-gpgchecks -y)
dnf5 "${common[@]}" --disable-repo='*' --releasever=43 install /rpms43/*.rpm
test "$(rpm --root /output -q --qf '%{VERSION}' fedora-release)" = 43
chroot /output /bin/bash -c 'source /etc/os-release; test "$VERSION_ID" = 43'
rpm --root /output -qa --qf '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' >/output/upgrade-before.rpms
printf 'preserved across Fedora releases\n' >/output/etc/conglobate-upgrade-canary
chmod 640 /output/etc/conglobate-upgrade-canary
chown 1234:2345 /output/etc/conglobate-upgrade-canary
echo RESTRICTED_FEDORA43_INSTALLED_PASS
dnf5 "${common[@]}" --repo=target44 --releasever=44 distro-sync
test "$(rpm --root /output -q --qf '%{VERSION}' fedora-release)" = 44
chroot /output /bin/bash -c 'source /etc/os-release; test "$VERSION_ID" = 44'
case "$(rpm --root /output -q --qf '%{RELEASE}' glibc)" in *.fc44) ;; *) exit 1 ;; esac
rpm --root /output -qa --qf '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' >/output/upgrade-after.rpms
test "$(cat /output/etc/conglobate-upgrade-canary)" = 'preserved across Fedora releases'
test "$(stat -c '%a:%u:%g' /output/etc/conglobate-upgrade-canary)" = 640:1234:2345
dnf5 "${common[@]}" --repo=target44 --releasever=44 check
echo RESTRICTED_FEDORA43_TO44_DISTRO_SYNC_PASS
