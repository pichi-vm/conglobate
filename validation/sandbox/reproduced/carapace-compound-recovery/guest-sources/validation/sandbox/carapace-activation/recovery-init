#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount --make-rprivate /
modprobe dm_mod
modprobe dm_zero
modprobe dm_snapshot
modprobe loop
export CARAPACE_REQUIRE_DM_TESTS=1
export CARAPACE_EXPECT_RECOVERY=1
timeout 30 /activation-tests assemble::crash_validation::kernel_ --nocapture --test-threads=1
timeout 30 /activation-tests assemble::tests::kernel_ --nocapture --test-threads=1
timeout 30 /activation-tests assemble::recovery_controls:: --nocapture --test-threads=1
timeout 30 /activation-tests assemble::compound_recovery:: --nocapture --test-threads=1
for ((i=0;i<100;i++)); do
 test "$(dmsetup ls)" = 'No devices found' && break
 sleep .02
done
test "$(dmsetup ls)" = 'No devices found'
test -z "$(losetup -a)"
echo CARAPACE_RECOVERY_CANDIDATE_AND_CLEANUP_PASS
