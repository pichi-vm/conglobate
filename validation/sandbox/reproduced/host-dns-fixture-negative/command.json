[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-host-dns-public-v1/vmlinuz",
  "-initrd",
  "/tmp/conglobate-host-dns-public-v1/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet",
  "-netdev",
  "user,id=upstream",
  "-device",
  "virtio-net-pci,netdev=upstream"
]
