[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "1024",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/var/tmp/conglobate-uml-alpine-boot-v1/kernel",
  "-initrd",
  "/var/tmp/conglobate-uml-alpine-boot-v1/initramfs",
  "-drive",
  "file=/dev/shm/conglobate-alpine-conglobate-uml-alpine-v4.raw,format=raw,if=none,id=root,snapshot=on",
  "-device",
  "virtio-blk-pci,drive=root",
  "-append",
  "console=ttyS0 root=/dev/vda rootfstype=ext4 rw init=/sbin/validation-init panic=1"
]
