#!/bin/bash
set -eu
mount --make-rprivate /
mount --bind /work/root /work/root
mount -t proc proc /work/root/proc
mount -t tmpfs -o nosuid,noexec tmpfs /work/root/dev
touch /work/root/dev/null
mount --bind /work/runtime/null /work/root/dev/null
# The two fixture targets are known in advance. This is not an implementation
# of a resolver for arbitrary image-controlled links.
if test -L /work/root/etc/resolv.conf; then
 target=/work/root/run/resolv.original
else
 target=/work/root/etc/resolv.conf
fi
if test "$1" != /stub; then
 mount --bind /work/resolv "$target"
 mount -o remount,bind,ro "$target"
fi
exec /entry-helper /work/root "$1" --restricted
