[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-corium-derived-v2/vmlinuz",
  "-initrd",
  "/tmp/conglobate-corium-derived-v2/initramfs",
  "-drive",
  "file=/tmp/conglobate-corium-root-v3/carapace.gpt,format=raw,if=none,id=base,readonly=on",
  "-device",
  "virtio-blk-pci,drive=base",
  "-device",
  "virtio-serial-pci",
  "-chardev",
  "file,id=export,path=/tmp/conglobate-corium-derived-v2/layer.bin",
  "-device",
  "virtserialport,chardev=export,name=conglobate.layer",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet"
]
