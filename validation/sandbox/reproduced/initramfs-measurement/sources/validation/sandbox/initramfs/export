#!/bin/bash
set -euo pipefail
kernels=(/work/raw/usr/lib/modules/*/vmlinuz)
test "${#kernels[@]}" = 1
{
 printf 'CONGLOBATE_BOOT_FIXTURE_V1\n'
 for file in "${kernels[0]}" /work/raw/boot/validation-initramfs.img; do
  test -f "$file" && test ! -L "$file"
  printf '%s %s\n' "$(stat -c %s "$file")" "$(sha256sum "$file" | { read -r digest rest; echo "$digest"; })"
  cat "$file"
 done
} >/dev/vport0p1
echo TRUSTED_BOOT_ARTIFACT_EXPORT_PASS
