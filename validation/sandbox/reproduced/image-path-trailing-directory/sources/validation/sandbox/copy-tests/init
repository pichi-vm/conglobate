#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount --make-rprivate /
mount -t tmpfs tmpfs /tmp
timeout 30 /copy-tests --include-ignored --nocapture --test-threads=1
echo COPY_ROOT_TESTS_PASS
