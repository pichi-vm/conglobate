#!/bin/bash
set -eu
mount --make-rprivate /
mount --bind /work/root /work/root
mount -t proc -o nosuid,nodev,noexec proc /work/root/proc
mount -t tmpfs -o nosuid,noexec tmpfs /work/root/dev
mkdir /work/root/dev/pts
mount -t devpts -o newinstance,nosuid,noexec,ptmxmode=0666,mode=620 devpts /work/root/dev/pts
ln -s pts/ptmx /work/root/dev/ptmx
touch /work/root/dev/null
mount --bind /work/runtime/null /work/root/dev/null
exec /entry-helper /work/root /credential-test.py
