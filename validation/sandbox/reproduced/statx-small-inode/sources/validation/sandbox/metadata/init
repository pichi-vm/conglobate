#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
modprobe fuse
modprobe loop
chmod 666 /dev/fuse
mkdir /work/view
for feature in metadata-csum without-metadata-csum; do
echo "METADATA_FEATURE $feature"
for namespace in kernel initial mapped; do
 echo "METADATA_NAMESPACE $namespace"
 truncate -s 0 /work/image
 truncate -s 64M /work/image
 if test "$feature" = metadata-csum; then
  mkfs.ext4 -qF /work/image
 else
  mkfs.ext4 -qF -O ^metadata_csum /work/image
 fi
 mount -o loop /work/image /work/view
 python3 /probe.py seed /work/view /work/unused
 umount /work/view
 touch /work/report.json /work/timestamps.json /work/fuse.log
 chown 100000:100000 /work/image /work/view /work/report.json /work/timestamps.json /work/fuse.log
 if test "$namespace" = kernel; then
  mount -o loop /work/image /work/view
  python3 /probe.py create /work/view/probe /work/report.json
  python3 /timestamps.py exercise /work/view /work/timestamps.json
  python3 /enospc.py /work/view
  umount /work/view
 elif test "$namespace" = initial; then
  /bin/bash /worker
 else
  unshare --user --mount --map-users 0:100000:65536 --map-groups 0:100000:65536 \
   --setuid 0 --setgid 0 /bin/bash /worker
 fi
 e2fsck -fn /work/image
 mount -o loop,ro /work/image /work/view
 python3 /probe.py verify /work/view/probe /work/report.json
 python3 /timestamps.py verify /work/view /work/timestamps.json
 test "$(cat /work/view/space-recovered)" = "write after freeing space"
 echo FILESYSTEM_ENOSPC_REMOUNT_PASS
 umount /work/view
 if test "$namespace" = kernel; then
  cp /work/report.json /work/reference.json
 else
  python3 /probe.py compare /work/reference.json /work/report.json
  echo "METADATA_REFERENCE_COMPARED $namespace $feature"
 fi
done
done
if test -f /expect-birthtime; then
 for namespace in kernel initial mapped; do
  echo "SMALL_INODE_NAMESPACE $namespace"
  truncate -s 0 /work/image
  truncate -s 64M /work/image
  mkfs.ext4 -qF -I 128 -b 4096 /work/image
  chown 100000:100000 /work/image /work/view /work/timestamps.json /work/fuse.log
  if test "$namespace" = kernel; then
   mount -o loop /work/image /work/view
   python3 /timestamps.py small-inode /work/view /work/timestamps.json
   umount /work/view
  elif test "$namespace" = initial; then
   TIMESTAMP_SMALL_INODE=1 /bin/bash /worker
  else
   TIMESTAMP_SMALL_INODE=1 unshare --user --mount --map-users 0:100000:65536 --map-groups 0:100000:65536 \
    --setuid 0 --setgid 0 /bin/bash /worker
  fi
  e2fsck -fn /work/image
  mount -o loop,ro /work/image /work/view
  python3 /timestamps.py small-inode-verify /work/view /work/timestamps.json
  umount /work/view
 done
fi
echo METADATA_MATRIX_COMPLETE
