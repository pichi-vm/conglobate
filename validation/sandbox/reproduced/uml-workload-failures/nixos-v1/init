#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export TMPDIR=/tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
modprobe ipv6
ip link set lo up
ip addr add 10.45.0.2/24 dev eth0
ip link set eth0 up
ip route add default via 10.45.0.1
mkdir -p /work /mnt /tmp /nix /nixpkgs /etc/nix /fallback
chmod 1777 /tmp
/usr/bin/busybox --install -s /fallback
export PATH="$PATH:/fallback"
printf 'root:x:0:0:root:/root:/bin/bash\n' >/etc/passwd
printf 'root:x:0:\n' >/etc/group
mkdir -p /root
printf 'nameserver 10.0.2.3\n' >/etc/resolv.conf
mount -t tmpfs -o size=3G tmpfs /nix
tar -xJf /nix.tar.xz -C /work
tar -xJf /nixpkgs.tar.xz -C /nixpkgs --strip-components=1
cp -a /work/nix-2.35.3-x86_64-linux/store /nix/
export PATH=/nix/store/kp71jf0isr8pix0nn2lx2x3hj3vasii5-nix-2.35.3/bin:$PATH
export NIX_SSL_CERT_FILE=/nix/store/zdl7dn1gmi1cxdw5a8hw6xsf4cz0rjmg-nss-cacert-3.123/etc/ssl/certs/ca-bundle.crt
export NIX_PATH=nixpkgs=/nixpkgs
export NIX_CONFIG='build-users-group =
sandbox = true
max-jobs = 1
cores = 1
'
nix-store --load-db < /work/nix-2.35.3-x86_64-linux/.reginfo
nix --version
nix-build /compile.nix --no-out-link
system=$(nix-build /nixpkgs/nixos -A system --no-out-link -I nixos-config=/configuration.nix)
echo "$system" >/system-path
installer=$(nix-build /nixpkgs -A nixos-install-tools --no-out-link)
mkfs.ext4 -F -q /dev/ubda
mount -t ext4 /dev/ubda /mnt
"$installer/bin/nixos-install" --root /mnt --system "$system" --no-bootloader --no-root-passwd
mkdir -p /mnt/boot
cp -L "$system/kernel" /mnt/boot/validation-kernel
cp -L "$system/initrd" /mnt/boot/validation-initrd
printf '%s/init\n' "$system" >/mnt/boot/validation-init
printf 'derived\n' >/mnt/nixos-derived
chown 1234:2345 /mnt/nixos-derived
printf 'UML_NIXOS_INSTALL_FIRMWARE_PASS\n'
nix-store --query --requisites "$system"
/usr/bin/busybox sync
umount /mnt
mount -t ext4 -o ro /dev/ubda /mnt
test "$(cat /mnt/nixos-derived)" = derived
test "$(stat -c '%u:%g' /mnt/nixos-derived)" = 1234:2345
test -s /mnt/boot/validation-kernel
test -s /mnt/boot/validation-initrd
umount /mnt
echo UML_NIXOS_OUTPUT_VERIFIED
/usr/bin/busybox poweroff -f
