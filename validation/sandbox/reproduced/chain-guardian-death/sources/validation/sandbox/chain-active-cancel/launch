#!/bin/bash
set -eu
mount --make-rprivate /
mount --bind /work/view /work/view
mount -t proc -o nosuid,nodev,noexec proc /work/view/proc
mount -t tmpfs -o nosuid,noexec tmpfs /work/view/dev
# No runtime device nodes are needed by this bounded command; stdin is already
# the trusted /dev/null handle and output is a pipe.
# Read the PID as seen through the trusted ancestor proc mount, before pivot.
read -r outer_pid rest </proc/self/stat
printf '%s\n' "$outer_pid" >/work/command.pid
for ((i=0;i<1000;i++)); do
 test -f /work/command-go && break
 sleep .01
done
test -f /work/command-go
exec /entry-helper /work/view /command --restricted
