#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount --make-rprivate /
mount -t tmpfs tmpfs /tmp
for module in loop dm_mod dm_snapshot dm_verity dm_zero; do modprobe "$module"; done
timeout 30 /scute-tests --include-ignored --nocapture --test-threads=1
for ((i=0;i<100;i++)); do
 if test "$(dmsetup ls)" = 'No devices found' && test -z "$(losetup -a)"; then break; fi
 sleep .02
done
test "$(dmsetup ls)" = 'No devices found'
test -z "$(losetup -a)"
echo SCUTE_ROOT_TESTS_AND_CLEANUP_PASS
