#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; sleep .2; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
ip link set lo up
for m in veth nf_tables nft_chain_nat nft_masq nft_ct tun; do modprobe "$m"; done
chmod 666 /dev/net/tun
ip netns add upstream
ip netns add command
ip netns add disabled
ip link add vm-up type veth peer name outside
ip link set outside netns upstream
ip addr add 172.27.0.1/24 dev vm-up
ip -6 addr add fd42:27::1/64 dev vm-up nodad
ip link set vm-up up
ip -n upstream addr add 172.27.0.2/24 dev outside
ip -n upstream -6 addr add fd42:27::2/64 dev outside nodad
ip -n upstream link set outside up
ip -n upstream link set lo up
ip -n upstream route add 10.44.0.0/24 via 172.27.0.1
ip -n upstream -6 route add fd42:44::/64 via fd42:27::1
ip link add vm-step type veth peer name inside
ip link set inside netns command
ip addr add 10.44.0.1/24 dev vm-step
ip -6 addr add fd42:44::1/64 dev vm-step nodad
ip link set vm-step up
ip -n command addr add 10.44.0.2/24 dev inside
ip -n command -6 addr add fd42:44::2/64 dev inside nodad
ip -n command link set inside up
ip -n command link set lo up
ip -n command route add default via 10.44.0.1
ip -n command -6 route add default via fd42:44::1
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
nft -f - <<'NFT'
table inet guard {
 chain input { type filter hook input priority 0; policy accept; iifname "vm-step" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept; iifname "vm-step" drop; }
 chain forward { type filter hook forward priority 0; policy drop; ct state established,related accept; iifname "vm-step" oifname "vm-up" accept; }
}
table ip nat {
 chain postrouting { type nat hook postrouting priority 100; oifname "vm-up" ip saddr 10.45.0.0/24 masquerade; }
}
table ip6 nat {
 chain postrouting { type nat hook postrouting priority 100; oifname "vm-up" ip6 saddr fd42:45::/64 masquerade; }
}
NFT
ip netns exec upstream python3 /server.py &
python3 /server.py &
sleep .2
python3 - <<'PY'
import socket
for address in [('127.0.0.1',8080),('::1',8080)]:
 with socket.create_connection(address,2) as connection:
  connection.sendall(b'GET / HTTP/1.0\r\n\r\n')
  assert b'200 OK' in connection.recv(1024)
print('BUILDER_ENDPOINT_POSITIVE_CONTROL_PASS',flush=True)
PY

ip netns exec command ip tuntap add tap0 mode tap user 1000
ip -n command addr add 10.45.0.1/24 dev tap0
ip -n command -6 addr add fd42:45::1/64 dev tap0 nodad
ip -n command link set tap0 up
ip netns exec command sysctl -w net.ipv4.ip_forward=1
ip netns exec command sysctl -w net.ipv6.conf.all.forwarding=1
ip route add 10.45.0.0/24 via 10.44.0.2
ip -6 route add fd42:45::/64 via fd42:44::2
ip -n upstream route add 10.45.0.0/24 via 172.27.0.1
ip -n upstream -6 route add fd42:45::/64 via fd42:27::1
modprobe virtio_pci
modprobe virtio_net
ip addr add 10.0.2.15/24 dev eth0
ip link set eth0 up
ip route add default via 10.0.2.2
nft add rule inet guard forward iifname vm-step oifname eth0 accept
nft add rule ip nat postrouting oifname eth0 ip saddr 10.45.0.0/24 masquerade
mkdir /work/uml-runtime
chown 1000:1000 /work/uml-runtime
chmod 700 /work/uml-runtime
ip netns exec command /launch enabled > /work/uml-enabled.log 2>&1 &
runner=$!
ready=0
for ((i=0;i<1200;i++)); do
 if grep -q UML_LISTENER_READY /work/uml-enabled.log; then ready=1; break; fi
 if ! kill -0 "$runner" 2>/dev/null; then set +e; wait "$runner"; echo UML_RUNNER_EXIT_$?; set -e; cat /work/uml-enabled.log; exit 1; fi
 sleep .05
done
test "$ready" = 1
ip netns exec command python3 - <<'CONTROL'
import socket
for addr in [('10.45.0.2',8081),('fd42:45::2',8081)]:
 with socket.create_connection(addr,1):pass
print('UML_LISTENER_POSITIVE_CONTROLS_PASS',flush=True)
CONTROL
ip netns exec upstream python3 - <<'INBOUND'
import socket
for addr in [('10.45.0.2',8081),('fd42:45::2',8081)]:
 try:socket.create_connection(addr,.4)
 except OSError:pass
 else:raise AssertionError('unsolicited inbound accepted')
print('UML_UNSOLICITED_INBOUND_BLOCKED_PASS',flush=True)
INBOUND
set +e
wait "$runner"
result=$?
set -e
cat /work/uml-enabled.log
test "$result" = 0
ip netns exec disabled /launch disabled
nft list ruleset
echo UML_NETWORK_SUITE_PASS
