#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in loop dm_mod dm_snapshot dm_verity dm_zero virtio_pci virtio_blk virtio_console; do modprobe "$module"; done
mkdir -p /sys/fs/cgroup
mount -t cgroup2 cgroup2 /sys/fs/cgroup
mkdir /sys/fs/cgroup/supervisor
echo $$ > /sys/fs/cgroup/supervisor/cgroup.procs
echo "+memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
mkdir /work/view
chown 100000:100000 /work/view
test -b /dev/vda1; test -b /dev/vda2
set +e
/derive-root
code=$?
set -e
test "$code" != 0
test ! -e /work/export
test ! -e /sys/fs/cgroup/uml-step
test ! -e /work/uml-runtime
for ((i=0;i<100;i++)); do
 set -- /sys/block/dm-*
 test ! -e "$1" && break
 sleep .05
done
set -- /sys/block/dm-*
test ! -e "$1"
test -z "$(losetup -a)"
echo UML_FAILED_SNAPSHOT_CLEANUP_PASS
sleep .1
