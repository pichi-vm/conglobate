#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
root=/work/root
mkdir -p "$root/usr" "$root/.old" "$root/proc" "$root/dev" "$root/tmp"
cp -a /usr/bin "$root/usr/"
cp -a /usr/lib "$root/usr/"
cp -a /usr/lib64 "$root/usr/"
ln -s usr/bin "$root/bin"
ln -s usr/lib "$root/lib"
ln -s usr/lib64 "$root/lib64"
cp /probe.py "$root/probe"
cp /process-probe.py "$root/process-probe.py"
cp /credential-test.py "$root/credential-test.py"
chmod 755 "$root/credential-test.py"
cp /usr/bin/credential-observer "$root/tmp/setid-observer"
chown 100000:100000 "$root/tmp/setid-observer"
chmod 6755 "$root/tmp/setid-observer"
cp /usr/bin/credential-observer "$root/tmp/filecap-observer"
chown 100000:100000 "$root/tmp/filecap-observer"
chmod 755 "$root/tmp/filecap-observer"
python3 - <<'PYATTR'
import os, struct
path = '/work/root/tmp/filecap-observer'
# Fixture-only root ID matches the mapped user namespace, not target image ABI.
value = struct.pack('<6I', 0x03000001, 1 << 10, 0, 0, 0, 100000)
os.setxattr(path, 'security.capability', value)
assert os.getxattr(path, 'security.capability') == value
PYATTR

chmod 755 "$root/probe"
chown 100000:100000 "$root/tmp"
echo synthetic-fd-canary >/canary
mkdir /work/runtime
mknod /work/runtime/null c 1 3
chmod 666 /work/runtime/null
chown 100000:100000 /work/runtime/null
POLICY_ENV_CANARY=must-not-inherit \
/usr/bin/python3 /driver.py 9</canary 257</canary
test "$(stat -c %a /dev/null)" = 666
echo POLICY_GUEST_PASS
