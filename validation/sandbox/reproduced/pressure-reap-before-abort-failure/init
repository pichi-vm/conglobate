#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; sleep .1; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
modprobe fuse
mount -t fusectl none /sys/fs/fuse/connections
chmod 666 /dev/fuse
for mode in abort clients-first; do
 mkdir -p /work/$mode/view
 truncate -s 64M /work/$mode/image
 mkfs.ext4 -qF /work/$mode/image
 chown -R 100000:100000 /work/$mode
 unshare --user --mount --net --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /worker "$mode" &
 worker=$!
 for ((i=0;i<200;i++)); do test -f /work/$mode/ready && break; sleep .025; done
 test -f /work/$mode/ready
 connections=(/sys/fs/fuse/connections/*)
 test "${#connections[@]}" = 1
 connection=${connections[0]}
 exec {abort}>"$connection/abort"
 for ((i=0;i<200;i++)); do
  read -r waiting <"$connection/waiting"
  test "$waiting" -ge 32 && break
  sleep .025
 done
 test "$waiting" -ge 32
 echo "PRESSURE_QUEUED $mode $waiting"
 if test "$mode" = clients-first; then
  touch /work/$mode/cancel-clients
  for ((i=0;i<200;i++)); do test -f /work/$mode/clients-reaped && break; sleep .025; done
  test -f /work/$mode/clients-reaped
 fi
 start=$SECONDS
 echo 1 >&$abort
 wait "$worker"
 test $((SECONDS - start)) -lt 10
 exec {abort}>&-
 test ! -e "$connection"
 connections=(/sys/fs/fuse/connections/*)
 test "${connections[0]}" = '/sys/fs/fuse/connections/*'
 echo "PRESSURE_CLEANUP_PASS $mode"
done
echo PRESSURE_MATRIX_PASS
