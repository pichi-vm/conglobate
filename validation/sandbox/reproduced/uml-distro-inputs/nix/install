#!/bin/sh

# This script installs the Nix package manager on your system by
# downloading a binary distribution and running its installer script
# (which in turn creates and populates /nix).

{ # Prevent execution if this script was only partially downloaded
oops() {
    echo "$0:" "$@" >&2
    exit 1
}

umask 0022

tmpDir="$(mktemp -d -t nix-binary-tarball-unpack.XXXXXXXXXX || \
          oops "Can't create temporary directory for downloading the Nix binary tarball")"
cleanup() {
    rm -rf "$tmpDir"
}
trap cleanup EXIT INT QUIT TERM

require_util() {
    command -v "$1" > /dev/null 2>&1 ||
        oops "you do not have '$1' installed, which I need to $2"
}

case "$(uname -s).$(uname -m)" in
    Linux.x86_64)
        hash=6ce3ce3703fdc241b560cba401c5d338042122fe5b1a81e07bf1a623f259eba0
        path=lvl36xg3p5ds20c76vg74hz3s2i7yv8q/nix-2.35.3-x86_64-linux.tar.xz
        system=x86_64-linux
        ;;
    Linux.i?86)
        hash=2da33d1d4aee2abe1d3d87db3aa8ada9edbbb31f13c814a5a3db1ea6ef936f13
        path=81sbxrjqcyfq664c0ikkjk16n7pcrf9k/nix-2.35.3-i686-linux.tar.xz
        system=i686-linux
        ;;
    Linux.aarch64)
        hash=4a770896faa4d308806d0b4516575e0581443dc817d634b951a219a280554c09
        path=97l5b32hqa29zzx3q8bii0sng34pf5mi/nix-2.35.3-aarch64-linux.tar.xz
        system=aarch64-linux
        ;;
    Linux.armv6l)
        hash=0195195b88dfdbb409cc0343f07696677b8816b24dce1814aca4837c292f777c
        path=my5lpw492hi7fwy0s1md8azmk8w5a16y/nix-2.35.3-armv6l-linux.tar.xz
        system=armv6l-linux
        ;;
    Linux.armv7l)
        hash=cfcfa5d9d3ed437cc147b5d474f0a3124e9ffece3ce58632cf19b03fc8584fde
        path=hm69vla6akvrfip8xzsbkf5cfqd5nahx/nix-2.35.3-armv7l-linux.tar.xz
        system=armv7l-linux
        ;;
    Linux.riscv64)
        hash=b62648c94dd67309907f78973bb55af050bfd656a88e3710bcb3962101c74054
        path=zy3lxqpp3famkzdj6s9zf0w054hdvjar/nix-2.35.3-riscv64-linux.tar.xz
        system=riscv64-linux
        ;;
    Darwin.x86_64)
        hash=87ecc413ddce6bb8a0d21d985fe972de2e17851730fd6ea97fb5526ff4939eee
        path=v3wz68wdbgkis307aj6habv1an7dd32n/nix-2.35.3-x86_64-darwin.tar.xz
        system=x86_64-darwin
        ;;
    Darwin.arm64|Darwin.aarch64)
        hash=3aa2e1ae2293f0ca6dc2dde74e52809e6b4a186a74302c8b6392f5efd433901d
        path=3wg885wfgmbdp8w5qr3hvlz61fpqlmj9/nix-2.35.3-aarch64-darwin.tar.xz
        system=aarch64-darwin
        ;;
    FreeBSD.amd64|FreeBSD.x86_64)
        hash=663de78731180af9a21a1467576ee858a6f452a29f5e35ff3aecf16008db9be8
        path=aicygh2x07s2wmw54swil6lp43z8mz8r/nix-2.35.3-x86_64-freebsd.tar.xz
        system=x86_64-freebsd
        ;;
    *) oops "sorry, there is no binary distribution of Nix for your platform";;
esac

# Use this command-line option to fetch the tarballs using nar-serve or Cachix
if [ "${1:-}" = "--tarball-url-prefix" ]; then
    if [ -z "${2:-}" ]; then
        oops "missing argument for --tarball-url-prefix"
    fi
    url=${2}/${path}
    shift 2
else
    url=https://releases.nixos.org/nix/nix-2.35.3/nix-2.35.3-$system.tar.xz
fi

tarball=$tmpDir/nix-2.35.3-$system.tar.xz

require_util tar "unpack the binary tarball"
if [ "$(uname -s)" != "Darwin" ]; then
    require_util xz "unpack the binary tarball"
fi

if command -v curl > /dev/null 2>&1; then
    fetch() { curl --fail -L "$1" -o "$2"; }
elif command -v wget > /dev/null 2>&1; then
    fetch() { wget "$1" -O "$2"; }
else
    oops "you don't have wget or curl installed, which I need to download the binary tarball"
fi

echo "downloading Nix 2.35.3 binary tarball for $system from '$url' to '$tmpDir'..."
fetch "$url" "$tarball" || oops "failed to download '$url'"

if command -v sha256sum > /dev/null 2>&1; then
    hash2="$(sha256sum -b "$tarball" | cut -c1-64)"
elif command -v shasum > /dev/null 2>&1; then
    hash2="$(shasum -a 256 -b "$tarball" | cut -c1-64)"
elif command -v openssl > /dev/null 2>&1; then
    hash2="$(openssl dgst -r -sha256 "$tarball" | cut -c1-64)"
else
    oops "cannot verify the SHA-256 hash of '$url'; you need one of 'shasum', 'sha256sum', or 'openssl'"
fi

if [ "$hash" != "$hash2" ]; then
    oops "SHA-256 hash mismatch in '$url'; expected $hash, got $hash2"
fi

unpack=$tmpDir/unpack
mkdir -p "$unpack"
tar -xJf "$tarball" -C "$unpack" || oops "failed to unpack '$url'"

script=$(echo "$unpack"/*/install)

[ -e "$script" ] || oops "installation script is missing from the binary tarball!"
export INVOKED_FROM_INSTALL_IN=1
"$script" "$@"

} # End of wrapping
