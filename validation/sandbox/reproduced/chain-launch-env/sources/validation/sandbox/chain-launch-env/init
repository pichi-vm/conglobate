#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'status=$?; for log in /runs/*/log; do test ! -f "$log" || cat "$log"; done; echo "GUEST_EXIT $status"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in fuse loop dm_mod dm_snapshot dm_verity dm_zero; do modprobe "$module"; done
dmsetup version
chmod 666 /dev/fuse
mkdir /work/view
truncate -s 64M /work/base
mkfs.ext4 -qF /work/base
mount -o loop /work/base /work/view
printf 'base fixture\n' >/work/view/inherited
printf 'base value\n' >/work/view/changed
mkdir -p /work/view/bin /work/view/lib64 /work/view/.old /work/view/proc /work/view/dev /work/view/tmp
for tool in bash cat chmod chown stat sleep; do cp "/usr/bin/$tool" /work/view/bin/; done
cp -a /usr/lib64/. /work/view/lib64/
cp /command /work/view/command
chmod 755 /work/view/command
umount /work/view
chown 100000:100000 /work/view
# Both builds start with the same filesystem bytes and authenticated root.
mkdir /runs
for id in A B; do
 mkdir /runs/$id /runs/$id/view
 chmod 1777 /runs/$id
 cp --sparse=always /work/base /runs/$id/base
 chown 100000:100000 /runs/$id/view
 : >/runs/$id/ready
 chmod 666 /runs/$id/ready
 unshare --mount /bin/bash /concurrent-run /runs/$id > /runs/$id/log 2>&1 &
 if test "$id" = A; then a=$!; else b=$!; fi
done
for ((i=0;i<1200;i++)); do
 if test -s /runs/A/ready && test -s /runs/B/ready; then break; fi
 kill -0 "$a"; kill -0 "$b"
 sleep .05
done
test -s /runs/A/ready; test -s /runs/B/ready
# Both trusted setup shells ran, but image commands are still at their gate.
test "$(cat /runs/A/launcher-canary)" = 'owned shell initialization'
test ! -e /runs/B/launcher-canary
echo PRECOMMAND_INHERITED_ENV_NEGATIVE_CONTROL_PASS
echo PRECOMMAND_CONSTRUCTED_ENV_CONTROL_PASS
dmsetup table > /runs/overlap.tables
cat /runs/overlap.tables
# File-backed staging deliberately creates distinct mapping stacks. The zero
# origin is shared by the two authenticated base snapshots.
writable=0; bases=0; zeros=0; origin=; first=
while read -r name start length type parent rest; do
 case "$name:$type" in
  conglobate-*:snapshot)
   writable=$((writable+1))
   if test -z "$first"; then first=$parent; else test "$first" != "$parent"; fi ;;
  CARAPACE-s*:snapshot)
   bases=$((bases+1))
   if test -z "$origin"; then origin=$parent; else test "$origin" = "$parent"; fi ;;
  CARAPACE-z::zero) zeros=$((zeros+1)) ;;
 esac
done </runs/overlap.tables
test "$writable:$bases:$zeros" = 2:2:1
echo CONCURRENT_SHARED_ZERO_DISTINCT_STACKS_PASS
: >/runs/A/go
wait "$a" || { cat /runs/A/log; exit 1; }
test -f /runs/A/published/inventory.cbor
test ! -e /runs/B/published
kill -0 "$b"
echo CONCURRENT_FIRST_PUBLISHED_SECOND_ACTIVE_PASS
: >/runs/B/go
wait "$b" || { cat /runs/B/log; exit 1; }
test -f /runs/B/published/inventory.cbor
cmp /work/base /runs/A/base
cmp /work/base /runs/B/base
for ((i=0;i<100;i++)); do
 set -- /sys/block/dm-*
 test ! -e "$1" && break
 sleep .05
done
# Loop devices can persist as empty kernel objects; only attached ones count.
test -z "$(losetup -a)"
set -- /sys/block/dm-*
test ! -e "$1"
test "$(cat /runs/A/launcher-canary)" = 'owned shell initialization'
test ! -e /runs/B/launcher-canary
echo CONCURRENT_COMPLETE_BUILDS_CLEANUP_PASS
echo FULL_BUILD_CONSTRUCTED_LAUNCH_ENV_PASS
