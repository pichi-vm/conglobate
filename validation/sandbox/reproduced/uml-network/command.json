[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-network-policy-v4/vmlinuz",
  "-initrd",
  "/var/tmp/conglobate-uml-network-v6/initramfs",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=1 quiet"
]
