[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/tmp/conglobate-initramfs-boot-v2/kernel",
  "-initrd",
  "/tmp/conglobate-initramfs-boot-v2/initramfs",
  "-append",
  "console=ttyS0 selinux=0 panic=-1 rd.shell=0"
]
