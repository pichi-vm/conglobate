#!/bin/bash
set -eu
/acl-patched -f -o kernel,acl,allow_other,nosuid,nodev /work/image /work/view >/work/fuse.log 2>&1 &
daemon=$!
trap 'fusermount3 -u /work/view; wait "$daemon"; cat /work/fuse.log' EXIT
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
python3 /probe.py create /work/view/probe /work/report.json

python3 /timestamps.py exercise /work/view /work/timestamps.json
