#!/bin/bash
set -u
export PATH=/usr/bin:/usr/sbin
finish() { echo "GUEST_EXIT $1"; sync; sleep .1; echo b >/proc/sysrq-trigger; }
trap 'finish $?' EXIT
set -e
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o mode=755 tmpfs /work
modprobe fuse
modprobe loop
modprobe dm_snapshot
chmod 666 /dev/fuse /dev/null /dev/zero /dev/random /dev/urandom
chown 100000:100000 /dev/null /dev/zero /dev/random /dev/urandom
mkdir -p /var/tmp
chmod 1777 /tmp /var/tmp
getenforce
echo trusted-secret >/supervisor-secret
mkdir /work/raw /work/view /work/runtime /work/tool
chown 100000:100000 /work/tool
mknod /work/runtime/null c 1 3
mknod /work/runtime/zero c 1 5
mknod /work/runtime/random c 1 8
mknod /work/runtime/urandom c 1 9
chmod 666 /work/runtime/*
chown 100000:100000 /work/runtime/*
truncate -s 2G /work/origin
mkfs.ext4 -q -F /work/origin
sha256sum /work/origin >/work/origin.sha
truncate -s 2G /work/cow
origin=$(losetup --find --show --read-only /work/origin)
cow=$(losetup --find --show /work/cow)
dmsetup create cg-validation --noudevsync --table "0 4194304 snapshot $origin $cow P 8"
dmsetup mknodes --noudevsync
ln -s /dev/mapper/cg-validation /work/image
chown 100000:100000 /dev/mapper/cg-validation /work/view
touch /work/fuse.log
chown 100000:100000 /work/fuse.log
unshare --user --mount --net --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /worker
cat /work/fuse.log
e2fsck -fn /work/image
mount -o loop /work/image /work/raw
stat -c '%u:%g' /work/raw/test-owned
getfacl -n /work/raw/test-owned
getfattr -n security.selinux /work/raw/test-owned
getcap -n /work/raw/test-caps
setpriv --reuid=12345 --regid=12345 --clear-groups --inh-caps=-all --ambient-caps=-all /work/raw/test-caps 0
chroot /work/raw /bin/bash -c 'echo INSTALLED_SHELL_PASS'
/bin/bash /initramfs-export
chroot /work/raw sha256sum -c /boot/validation-initramfs.sha256
echo INITRAMFS_KERNEL_REMOUNT_PASS
chroot /work/raw sha256sum -c /boot/validation-root-initramfs.sha256
test "$(cat /work/raw/usr/share/conglobate-upgrade/version)" = 2
test "$(cat /work/raw/etc/conglobate-upgrade.conf)" = 'administrator edit'
test "$(cat /work/raw/etc/conglobate-upgrade.conf.rpmnew)" = default-2
test "$(stat -c '%a:%u:%g' /work/raw/var/lib/conglobate-upgrade/state)" = 640:1234:2345
echo UPGRADE_KERNEL_REMOUNT_PASS
umount /work/raw
/bin/bash /root-export
dmsetup status cg-validation
sha256sum -c /work/origin.sha
dmsetup remove --noudevsync cg-validation
losetup -d "$origin" "$cow"
truncate -s 64M /work/failure
mkfs.ext4 -q -F /work/failure
chown 100000:100000 /work/failure
unshare --user --mount --net --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /crash-worker
rm /work/failure
echo VALIDATION_PASS
