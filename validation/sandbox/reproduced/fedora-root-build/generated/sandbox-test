#!/bin/bash
set -euo pipefail
echo SANDBOX_BEGIN
cat /proc/self/uid_map
for path in /work/image /rpms /worker /context /dev/fuse /.old/work /proc/1/root/work; do
 test ! -e "$path" || { echo "EXPOSURE $path"; exit 1; }
done
for process in /proc/[0-9]*/comm; do
 read -r name < "$process"
 test "$name" != fuse2fs || exit 1
done
stat -c "%a %u:%g %t:%T" /dev/null
cat /proc/self/mountinfo
echo device-write >/dev/null
/usr/bin/python3 - <<'PYTEST'
import os,errno
try:
    os.kill(int(open('/daemon-pid').read()),0)
except OSError as e:
    assert e.errno==errno.ESRCH,e
else:
    raise AssertionError('filesystem daemon is visible')
print('DAEMON_PID_INACCESSIBLE_PASS')
PYTEST
for fd in /proc/self/fd/*; do readlink "$fd" || true; done
echo VISIBILITY_PASS
touch /test-owned
chown 1000:1000 /test-owned
setfacl -m u:1234:rw /test-owned
setfattr -n security.selinux -v system_u:object_r:conglobate_target_only_t:s0 /test-owned
cp /usr/bin/getpcaps /test-caps
setcap cap_net_bind_service=ep /test-caps
getcap /test-caps
getfattr -n security.selinux /test-owned
if mknod /test-device c 1 3; then echo MKNOD_UNEXPECTED_SUCCESS; exit 1; else echo MKNOD_EXPECTED_DENIAL; fi
(for ((i=0;i<3600;i++)); do echo alive >> /heartbeat; sleep .1; done) &
sleep .3
/usr/bin/python3 /adversarial.py
/usr/bin/python3 /semantics.py
/bin/bash /initramfs-command
/bin/bash /root-boot-command
rpm --dbpath /usr/lib/sysimage/rpm --nosignature --nodeps --replacepkgs -U /transaction-fixture.rpm
rpm --dbpath /usr/lib/sysimage/rpm --nodeps -e attr
test ! -e /usr/bin/getfattr
rpm --dbpath /usr/lib/sysimage/rpm --nosignature --nodeps -i /transaction-fixture.rpm
test -x /usr/bin/getfattr
getfattr -n security.selinux /test-owned
echo RESTRICTED_RPM_REINSTALL_REMOVE_INSTALL_PASS
/bin/bash /upgrade-command
chmod 000 /dev/null
echo RUNTIME_DEVICE_MUTATED
a=$(stat -c %s /heartbeat)
b=$(stat -c %s /detached-heartbeat)
sleep .3
test "$(stat -c %s /heartbeat)" -gt "$a"
test "$(stat -c %s /detached-heartbeat)" -gt "$b"
echo DESCENDANTS_ALIVE_BEFORE_EXIT_PASS
echo SANDBOX_PASS
