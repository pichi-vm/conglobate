#!/bin/bash
set -eu
rpm --dbpath /usr/lib/sysimage/rpm --nosignature --nodeps -i /upgrade-1.rpm
test "$(rpm --dbpath /usr/lib/sysimage/rpm -q --qf '%{VERSION}' conglobate-validation-fixture)" = 1
test "$(cat /usr/share/conglobate-upgrade/version)" = 1
printf 'administrator edit\n' >/etc/conglobate-upgrade.conf
rpm --dbpath /usr/lib/sysimage/rpm --nosignature --nodeps -U /upgrade-2.rpm
test "$(rpm --dbpath /usr/lib/sysimage/rpm -q --qf '%{VERSION}' conglobate-validation-fixture)" = 2
test "$(cat /usr/share/conglobate-upgrade/version)" = 2
test "$(cat /etc/conglobate-upgrade.conf)" = 'administrator edit'
test "$(cat /etc/conglobate-upgrade.conf.rpmnew)" = default-2
test "$(stat -c '%a:%u:%g' /var/lib/conglobate-upgrade/state)" = 640:1234:2345
python3 - <<'PY'
from pathlib import Path
expected = ['pre-1-1', 'post-1-1', 'pre-2-2', 'post-2-2', 'preun-1-1', 'postun-1-1']
actual = Path('/var/log/conglobate-upgrade-scriptlets').read_text().splitlines()
assert actual == expected, actual
PY
echo RESTRICTED_VERSION_UPGRADE_CONFIG_SCRIPTLETS_PASS
