#!/bin/bash
set -euo pipefail
trap 'echo "ROOT_BOOT_PROBE_FAILED_LINE_$LINENO" >/dev/console' ERR
read -r init </proc/1/comm
test "$init" = systemd
test ! -e /etc/initrd-release
test "$(cat /conglobate-root-identity)" = 'owned Fedora root boot fixture'
source /etc/os-release
test "$ID" = fedora
test "$VERSION_ID" = 44
root_found=0
while read -r source mountpoint filesystem rest; do
 if test "$mountpoint" = / && test "$filesystem" = ext4; then root_found=1; fi
done </proc/mounts
test "$root_found" = 1
test -c /dev/null
test -d /sys/class
rpm -q bash systemd kernel-core
printf 'FEDORA_ROOT_SWITCH_SYSTEMD_PASS %s\n' "$(uname -r)" >/dev/console
systemctl --no-block poweroff
