#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'status=$?; for log in /runs/*/log; do if test -f "$log"; then echo "BEGIN_BUILD_LOG $log"; cat "$log"; echo "END_BUILD_LOG $log"; fi; done; echo "GUEST_EXIT $status"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in fuse loop dm_mod dm_snapshot dm_verity dm_zero; do modprobe "$module"; done
dmsetup version
chmod 666 /dev/fuse
mkdir /work/view
truncate -s 64M /work/base
mkfs.ext4 -qF -b 4096 /work/base
mount -o loop /work/base /work/view
printf 'base fixture\n' >/work/view/inherited
printf 'base value\n' >/work/view/changed
mkdir -p /work/view/bin /work/view/lib64 /work/view/.old /work/view/proc /work/view/dev /work/view/tmp
for tool in bash cat chmod chown stat sleep; do cp "/usr/bin/$tool" /work/view/bin/; done
cp -a /usr/lib64/. /work/view/lib64/
cp /command /work/view/command
chmod 755 /work/view/command
umount /work/view
chown 100000:100000 /work/view
# Prepare one read-only pair of block devices shared by both independent builds.
mkdir /shared
mount -t tmpfs tmpfs /shared
/shared-base
for layer in base layer; do
 losetup --read-only --find --show /shared/$layer/data >/shared/$layer-data-device
 losetup --read-only --find --show /shared/$layer/hash >/shared/$layer-hash-device
done
sha256sum /shared/base/data /shared/base/hash /shared/layer/data /shared/layer/hash >/shared/before.sha256
export CHAIN_SHARED_BLOCK=1
# Both builds start with the same filesystem bytes and authenticated root.
mkdir /runs
for id in A B; do
 mkdir /runs/$id /runs/$id/view
 chmod 1777 /runs/$id
 cp --sparse=always /work/base /runs/$id/base
 if test "$id" = A; then : >/runs/$id/fail; fi
 chown 100000:100000 /runs/$id/view
 : >/runs/$id/ready
 chmod 666 /runs/$id/ready
 unshare --mount /bin/bash /concurrent-run /runs/$id > /runs/$id/log 2>&1 &
 if test "$id" = A; then a=$!; else b=$!; fi
done
for ((i=0;i<1200;i++)); do
 if test -s /runs/A/ready && test -s /runs/B/ready; then break; fi
 kill -0 "$a"; kill -0 "$b"
 sleep .05
done
test -s /runs/A/ready; test -s /runs/B/ready
dmsetup table > /runs/overlap.tables
cat /runs/overlap.tables
# Both assemblers share the full base snapshot and verity mapping.
writable=0; bases=0; zeros=0; verities=0; first=
while read -r name start length type parent rest; do
 case "$name:$type" in
  conglobate-*:snapshot)
   writable=$((writable+1))
   if test -z "$first"; then first=$parent; else test "$first" = "$parent"; fi ;;
  CARAPACE-s*:snapshot)
   bases=$((bases+1))
   ;;
  CARAPACE-v*:verity) verities=$((verities+1)) ;;
  CARAPACE-z::zero) zeros=$((zeros+1)) ;;
 esac
done </runs/overlap.tables
test "$writable:$bases:$zeros:$verities" = 2:2:1:2
echo CONCURRENT_TWO_LAYER_SHARED_BLOCK_STACK_PASS
echo CONCURRENT_SHARED_BLOCK_STACK_PASS
: >/runs/A/go
set +e
wait "$a"
status=$?
set -e
test "$status" = 101
test ! -e /runs/A/published
test ! -e /runs/A/verified
test ! -e /runs/B/published
kill -0 "$b"
sha256sum -c /shared/before.sha256
echo CONCURRENT_FIRST_FAILED_SECOND_ACTIVE_PASS
: >/runs/B/go
wait "$b" || { cat /runs/B/log; exit 1; }
test -f /runs/B/published/inventory.cbor
cmp /work/base /runs/A/base
cmp /work/base /runs/B/base
for ((i=0;i<100;i++)); do
 set -- /sys/block/dm-*
 test ! -e "$1" && break
 sleep .05
done
sha256sum -c /shared/before.sha256
for layer in base layer; do
 losetup -d "$(cat /shared/$layer-data-device)"
 losetup -d "$(cat /shared/$layer-hash-device)"
done
# Only attached loop devices count.
test -z "$(losetup -a)"
set -- /sys/block/dm-*
test ! -e "$1"
echo CONCURRENT_FAILURE_SURVIVOR_CLEANUP_PASS
