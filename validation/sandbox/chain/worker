#!/bin/bash
set -eu
device=$1
/patched -f -o kernel,acl,allow_other,nosuid,nodev "$device" /work/view >/work/worker.log 2>&1 &
daemon=$!
trap 'fusermount3 -u /work/view; wait "$daemon"; cat /work/worker.log' EXIT
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
test "$(cat /work/view/inherited)" = 'base fixture'
printf 'derived fixture\n' >/work/view/derived
printf 'derived value\n' >/work/view/changed
chmod 640 /work/view/derived
chown 1234:2345 /work/view/derived
