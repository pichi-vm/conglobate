#!/bin/bash
set -euo pipefail
fuse2fs -f -o acl,allow_other /work/image /work/view >/work/fuse.log 2>&1 &
daemon=$!
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
echo before >/work/view/before
kill -STOP "$daemon"
touch /work/view/blocked &
client=$!
echo ready >/work/ready
set +e
wait "$client"
status=$?
set -e
test "$status" != 0
echo HUNG_REQUEST_ABORTED_PASS
kill -KILL "$daemon"
wait "$daemon" || true
fusermount3 -u /work/view
echo HUNG_CONNECTION_CLEANUP_PASS
