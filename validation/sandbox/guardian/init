#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
root=/work/root
mkdir -p "$root/usr" "$root/.old" "$root/proc" "$root/dev" "$root/tmp"
cp -a /usr/bin "$root/usr/"
cp -a /usr/lib "$root/usr/"
cp -a /usr/lib64 "$root/usr/"
ln -s usr/bin "$root/bin"
ln -s usr/lib "$root/lib"
ln -s usr/lib64 "$root/lib64"
cp /probe.py "$root/probe"
chmod 755 "$root/probe"
chown 100000:100000 "$root/tmp"
mkdir /work/runtime
mknod /work/runtime/null c 1 3
chmod 666 /work/runtime/null
chown 100000:100000 /work/runtime/null
touch /work/phase
chown 100000:100000 /work/phase
mkdir -p /sys/fs/cgroup
mount -t cgroup2 none /sys/fs/cgroup
python3 /guardian.py
echo GUARDIAN_MATRIX_PASS
