#!/bin/bash
set -eu
for path in /work/context /context /copy-helper /dev/fuse /outside-canary; do
 test ! -e "$path"
done
mkdir /etc /safe /appended
printf 'builder:x:1234:2345::/:/bin/sh\n' >/etc/passwd
printf 'builders:x:2345:\n' >/etc/group
printf 'image fixture\n' >/image-canary
ln -s /image-canary /appended/file
ln -s /outside-canary /outside-link
ln -s /cycle /cycle
ln -s /safe /destination
# Ordinary disposable fixture writer, killed with the command PID namespace.
(while :; do
 printf 'fixture\n' >>/heartbeat
 ln -sfn /safe /pending
 mv -Tf /pending /destination
 sleep .01
done) &
sleep .1
echo COPY_COMMAND_CONTEXT_INACCESSIBLE_PASS
