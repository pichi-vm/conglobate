#!/bin/bash
set -eu
mount --make-rprivate /
mount -t tmpfs tmpfs /work/context
/copy-helper prepare
mount --bind /work/context /work/context
mount -o remount,bind,ro /work/context
fuse2fs -f -o acl,allow_other,errors=panic,nosuid,nodev /work/image /work/view >/work/view.log 2>&1 &
daemon=$!
trap 'fusermount3 -u /work/view; wait "$daemon"' EXIT
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
p=/work/view
mkdir -p "$p/usr/bin" "$p/usr/lib64" "$p/proc" "$p/.old" "$p/dev"
cp /usr/bin/bash /usr/bin/mkdir /usr/bin/ln /usr/bin/mv /usr/bin/sleep "$p/usr/bin/"
cp -a /usr/lib64/. "$p/usr/lib64/"
ln -s usr/bin "$p/bin"
ln -s usr/lib64 "$p/lib64"
cp /command "$p/command"
chmod 755 "$p/command"
unshare --mount --pid --net --ipc --uts --fork /bin/bash /launch
# The PID namespace has terminated. No recipe writer may remain when COPY
# resolves the tree. Check a bounded heartbeat as supporting teardown evidence.
before=$(stat -c %s "$p/heartbeat")
sleep .1
test "$before" = "$(stat -c %s "$p/heartbeat")"
echo COPY_NO_WRITERS_BARRIER_PASS
/copy-helper copy
if test -x /export-tests; then
 CONGLOBATE_EXPORT_BLOCK_DEVICE=/export-block TMPDIR="$p" \
  timeout 20 /export-tests build::export_tests --nocapture --test-threads=1
 echo EXPORT_IMPLEMENTATION_TESTS_PASS
fi
timeout 1 /copy-helper fifo-account
test ! -e "$p/should-not-be-produced"
rm "$p/etc/passwd"
echo COPY_WORKER_PASS
