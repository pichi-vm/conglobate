#!/bin/bash
set -euo pipefail
mount --make-rprivate /
p=/work/view
mount --bind "$p" "$p"
mount -t proc -o nosuid,nodev,noexec proc "$p/proc"
mount -t tmpfs -o nosuid,noexec tmpfs "$p/dev"
touch "$p/dev/null" "$p/dev/zero" "$p/dev/random" "$p/dev/urandom"
for d in null zero random urandom; do mount --bind "/work/runtime/$d" "$p/dev/$d"; done
exec /entry-helper "$p" /sandbox-test
