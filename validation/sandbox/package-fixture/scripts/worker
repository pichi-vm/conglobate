#!/bin/bash
set -euo pipefail
fuse2fs -f -o kernel,acl,allow_other,nosuid,nodev /work/image /work/view >/work/fuse.log 2>&1 &
daemon=$!
trap 'if test -n "${canary:-}"; then kill "$canary"; wait "$canary" || true; fi; fusermount3 -u /work/view; wait "$daemon"' EXIT
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .1; done
mountpoint -q /work/view
p=/work/view
echo outer-device-write >/dev/null
echo PACKAGE_INSTALL_BEGIN
dnf5 --no-plugins --disable-repo='*' --installroot="$p" --releasever=44 --use-host-config --setopt=install_weak_deps=False --no-gpgchecks -y install /rpms/*.rpm
echo PACKAGE_INSTALL_PASS
cp /sandbox-test "$p/sandbox-test"
chmod 755 "$p/sandbox-test"
cp /adversarial.py "$p/adversarial.py"
cp /semantics.py "$p/semantics.py"
cp /trusted-canary "$p/trusted-canary"
chroot "$p" /usr/bin/python3 /trusted-canary &
canary=$!
for ((i=0;i<100;i++)); do test -f "$p/canary-ready" && break; sleep .05; done
printf '%s\n' "$daemon" > "$p/daemon-pid"
mkdir -p "$p/proc" "$p/dev" "$p/.old" "$p/tmp"
unshare --mount --pid --net --ipc --uts --fork /bin/bash /sandbox-entry </dev/null 2>&1 | cat
before=$(stat -c %s "$p/heartbeat")
sleep 1
after=$(stat -c %s "$p/heartbeat")
test "$before" = "$after"
d_before=$(stat -c %s "$p/detached-heartbeat")
sleep 1
d_after=$(stat -c %s "$p/detached-heartbeat")
test "$d_before" = "$d_after"
echo DETACHED_DESCENDANT_TERMINATION_PASS
test "$(stat -c %a /dev/null)" = 666
test "$(stat -c %a /work/runtime/null)" = 0
echo still-usable >/dev/null
echo BUILDER_DEVICE_UNCHANGED_PASS
kill -0 "$canary"
kill "$canary"
wait "$canary" || true
canary=
echo DESCENDANT_TERMINATION_PASS
kill -0 "$daemon"
echo DAEMON_SURVIVED_PASS
setfattr -n security.selinux -v system_u:object_r:conglobate_target_only_t:s0 "$p/sandbox-test"
echo WORKER_PASS
