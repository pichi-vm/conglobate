#!/bin/bash
set -eu
test "$$" = 1
for path in /work /context /entry-helper /publication-helper /dev/fuse /dev/mapper/control /.old/work; do
 test ! -e "$path"
done
nnp=
seccomp=
while read -r key value rest; do
 case "$key" in
  NoNewPrivs:) nnp=$value ;;
  Seccomp:) seccomp=$value ;;
 esac
done </proc/self/status
test "$nnp" = 1
test "$seccomp" = 2
test "$(cat /inherited)" = 'base fixture'
printf 'derived fixture\n' >/derived
printf 'derived value\n' >/changed
chmod 640 /derived
chown 1234:2345 /derived
: >/heartbeat
: >/child-heartbeat
# Keep ordinary owned image-file descriptors open for the containment audit.
exec 3>>/heartbeat
exec 4>>/child-heartbeat
(for ((i=0;i<3000;i++)); do printf '.' >&4; sleep .02; done) <&0 &
for ((i=0;i<3000;i++)); do printf '.' >&3; sleep .02; done
exit 0
