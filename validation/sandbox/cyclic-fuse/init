#!/bin/bash
set -eu
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount --make-rprivate /
mount -t tmpfs tmpfs /work
modprobe fuse
mount -t fusectl none /sys/fs/fuse/connections
chmod 666 /dev/fuse
mkdir /work/view
chown -R 100000:100000 /work
unshare --user --mount --net --map-users 0:100000:65536 --map-groups 0:100000:65536 --setuid 0 --setgid 0 /bin/bash /worker &
worker=$!
for ((i=0;i<200;i++)); do test -f /work/callback-entered && break; sleep .02; done
test -f /work/callback-entered
connections=(/sys/fs/fuse/connections/*)
test "${#connections[@]}" = 1
connection=${connections[0]}
exec {abort}>"$connection/abort"
for ((i=0;i<200;i++)); do
 read -r waiting <"$connection/waiting"
 test "$waiting" -ge 2 && break
 sleep .02
done
test "$waiting" -ge 2
test ! -e /work/client-error
test ! -e /work/nested-error
echo "CYCLIC_CALLBACK_DEPENDENCY_QUEUED $waiting"
start=$SECONDS
echo 1 >&$abort
wait "$worker"
test $((SECONDS - start)) -lt 10
exec {abort}>&-
test "$(cat /work/nested-error)" = 103 -o "$(cat /work/nested-error)" = 107
test ! -e "$connection"
echo CYCLIC_ABORT_RELEASES_CALLBACK_AND_CLIENT_PASS
