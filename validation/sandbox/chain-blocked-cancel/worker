#!/bin/bash
set -euo pipefail
device=$1
/patched -f -o kernel,acl,allow_other,nosuid,nodev "$device" /work/view >/work/worker.log 2>&1 &
daemon=$!
printf '%s\n' "$daemon" >/work/daemon.pid
for ((i=0;i<100;i++)); do mountpoint -q /work/view && break; sleep .05; done
mountpoint -q /work/view
set +e
python3 /cancel-driver.py
status=$?
set -e
test "$status" = 125
kill -KILL "$daemon"
set +e
wait "$daemon"
daemon_status=$?
set -e
test "$daemon_status" = 137
fusermount3 -u /work/view
if mountpoint -q /work/view; then exit 1; fi
echo BLOCKED_CANCEL_WORKER_REAPED_UNMOUNTED
exit 125
