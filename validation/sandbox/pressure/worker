#!/bin/bash
set -eu
export LC_ALL=C
mode=$1
p=/work/$mode
fuse2fs -f -o acl,allow_other "$p/image" "$p/view" >"$p/log" 2>&1 &
daemon=$!
for ((i=0;i<100;i++)); do mountpoint -q "$p/view" && break; sleep .05; done
mountpoint -q "$p/view"
for ((i=0;i<32;i++)); do mkdir "$p/view/d$i"; done
# All requests occur after preparation. Freeze only the disposable worker.
kill -STOP "$daemon"
clients=()
for ((i=0;i<32;i++)); do
 touch "$p/view/d$i/new" >"$p/client-$i.log" 2>&1 &
 clients+=("$!")
done
touch "$p/ready"
if test "$mode" = clients-first; then
 for ((i=0;i<400;i++)); do test -f "$p/cancel-clients" && break; sleep .025; done
 test -f "$p/cancel-clients"
 for client in "${clients[@]}"; do kill -KILL "$client"; done
 touch "$p/clients-signaled"
fi
for client in "${clients[@]}"; do
 if wait "$client"; then echo UNEXPECTED_CLIENT_SUCCESS; exit 1; else status=$?; fi
 echo "CLIENT_STATUS $mode $client $status"
 if test "$mode" = clients-first; then test "$status" = 137; else test "$status" = 1; fi
 for ((j=0;j<100;j++)); do test ! -e "/proc/$client" && break; sleep .01; done
 if test -e "/proc/$client"; then cat "/proc/$client/status"; exit 1; fi
done
if test "$mode" = abort; then
 for ((i=0;i<32;i++)); do
  message=$(cat "$p/client-$i.log")
  case "$message" in *"Software caused connection abort"*|*"Transport endpoint is not connected"*) ;; *) echo "$message"; exit 1 ;; esac
 done
 echo PRESSURE_ABORT_ERRORS_VERIFIED
fi
echo "PRESSURE_CLIENTS_REAPED $mode"
if test "$mode" = clients-first; then
 # Wait for the supervisor's abort; ENOTCONN/ECONNABORTED must be immediate
 # after that operation. The external guest timeout bounds this diagnostic.
 if timeout 10 stat "$p/view/after-abort" >"$p/post.log" 2>&1; then exit 1; else status=$?; fi
 test "$status" = 1
 message=$(cat "$p/post.log")
 case "$message" in *"Software caused connection abort"*|*"Transport endpoint is not connected"*) ;; *) echo "$message"; exit 1 ;; esac
 echo PRESSURE_NEW_REQUEST_REJECTED
fi
kill -KILL "$daemon"
wait "$daemon" || true
fusermount3 -u "$p/view"
test ! -e "/proc/$daemon"
if mountpoint -q "$p/view"; then exit 1; fi
echo "PRESSURE_WORKER_REAPED_UNMOUNTED $mode"
