#!/usr/bin/python3
from pathlib import Path
import sys
assert sys.argv[1:] == ['/work/view', '/command', '--restricted']
assert Path('/work/mode').read_text() == 'directories'
mounts = {}
for line in Path('/proc/self/mountinfo').read_text().splitlines():
    left, right = line.split(' - ', 1)
    mounts[left.split()[4]] = right.split()[0]
assert mounts.get('/work/view/proc') == 'proc'
assert mounts.get('/work/view/dev') == 'tmpfs'
assert '/work/canary' not in mounts
print('PINNED_RUNTIME_ENTRY_VALID_CONTROL_PASS', flush=True)
