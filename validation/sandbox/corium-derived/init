#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
trap 'echo "GUEST_EXIT $?"; echo b >/proc/sysrq-trigger' EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /work
mount --make-rprivate /
for module in fuse loop dm_mod dm_snapshot dm_verity dm_zero virtio_pci virtio_blk virtio_console; do modprobe "$module"; done
chmod 666 /dev/fuse
mkdir /work/view
chown 100000:100000 /work/view
test -b /dev/vda1; test -b /dev/vda2
/derive-root
for ((i=0;i<100;i++)); do
 set -- /sys/block/dm-*
 test ! -e "$1" && break
 sleep .05
done
set -- /sys/block/dm-*
test ! -e "$1"
test -z "$(losetup -a)"
ports=0
for namefile in /sys/class/virtio-ports/*/name; do
 read -r name <"$namefile"
 if test "$name" = conglobate.layer; then
  port=${namefile%/name}; port=${port##*/}
  test -c "/dev/$port"
  /derive-root --export "/dev/$port"
  ports=$((ports+1))
 fi
done
test "$ports" = 1
echo DERIVED_BOOT_EXPORT_AND_CLEANUP_PASS
