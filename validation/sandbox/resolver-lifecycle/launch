#!/bin/bash
set -eu
mount --make-rprivate /
stage=$1
gate() {
 if test "$stage" = "$1"; then
  read -r outer_pid rest </proc/self/stat
  printf '%s\n' "$outer_pid" >/work/ready
  for ((i=0;i<1000;i++)); do sleep .01; done
  exit 1
 fi
}
gate before-bind
mount --bind /work/resolver /work/image/etc/resolv.conf
gate after-bind
mount -o remount,bind,ro /work/image/etc/resolv.conf
test "$(cat /work/image/etc/resolv.conf)" = 'nameserver 192.0.2.53'
if printf bad >/work/image/etc/resolv.conf; then exit 1; fi
gate after-readonly
exit 1
