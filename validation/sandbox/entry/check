#!/bin/bash
set -eu
if test -e /.old/supervisor-secret; then
 read -r canary < /.old/supervisor-secret
 test "$canary" = supervisor-canary
 read -r canary <&9
 test "$canary" = supervisor-canary
 echo ENTRY_CANARIES_VISIBLE_BEFORE_CLEANUP
else
 test ! -e /.old/etc/passwd
 test "$PWD" = /
 test -z "${EVIL_SETUP:-}"
 if { true <&9; }; then exit 1; fi
 echo ENTRY_CANARIES_INACCESSIBLE_AFTER_CLEANUP_PASS
fi
