[Unit]
Description=Conglobate build appliance (build-port CBOR on dev.pichi.build)
Requires=run-pichi-repo.mount run-pichi-cache.mount run-pichi-output.mount
After=run-pichi-repo.mount run-pichi-cache.mount run-pichi-output.mount
# Sync and unmount output before powering off, without waiting on getty.
SuccessAction=poweroff-force
FailureAction=poweroff

[Service]
Type=oneshot
RuntimeDirectory=conglobate
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/conglobate appliance
# Image cmdline is console=hvc0, so the console copy is the build console.
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
