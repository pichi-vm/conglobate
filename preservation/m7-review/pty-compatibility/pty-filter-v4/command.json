[
  "qemu-system-x86_64",
  "-accel",
  "kvm",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/storage/conglobate-validation/pty-filter-v4/vmlinuz",
  "-initrd",
  "/storage/conglobate-validation/pty-filter-v4/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet",
  "-drive",
  "file=/storage/conglobate-validation/pty-filter-v4/status.raw,format=raw,if=none,id=status",
  "-device",
  "virtio-blk-pci,drive=status"
]
