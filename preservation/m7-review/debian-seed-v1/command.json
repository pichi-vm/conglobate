[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/var/tmp/conglobate-debian-seed-v1/vmlinuz",
  "-initrd",
  "/var/tmp/conglobate-debian-seed-v1/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet",
  "-drive",
  "file=/var/tmp/conglobate-debian-seed-v1/root.ext4,format=raw,if=virtio"
]
