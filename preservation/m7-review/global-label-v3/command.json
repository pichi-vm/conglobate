[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/var/tmp/conglobate-global-label-v3/vmlinuz",
  "-initrd",
  "/var/tmp/conglobate-global-label-v3/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 lsm=capability,bpf panic=-1 quiet"
]
