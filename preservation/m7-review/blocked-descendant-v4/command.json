[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "2",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-kernel",
  "/var/tmp/conglobate-blocked-descendant-v4/vmlinuz",
  "-initrd",
  "/var/tmp/conglobate-blocked-descendant-v4/initramfs.gz",
  "-append",
  "console=ttyS0 rdinit=/init selinux=0 panic=-1 quiet lsm=capability,bpf",
  "-drive",
  "file=/var/tmp/conglobate-blocked-descendant-v4/status.raw,format=raw,if=virtio"
]
